# PostgreSQL 15 with Patroni for automated primary/standby failover
# (NFR-AVAIL-002, IDD §8.2a, MDS §4.12).
#
# One image, three identical containers. Patroni supervises a normal
# `postgres` process and coordinates leader election via etcd — which node
# is primary is DCS state, not something baked into the image or chosen at
# build time.
FROM postgres:15-alpine

RUN apk add --no-cache python3 py3-pip py3-psycopg2 \
    && pip install --no-cache-dir --break-system-packages "patroni[etcd3]==3.3.*" \
    && rm -rf /var/cache/apk/*

COPY config/postgres/patroni.yml /etc/patroni/patroni.yml

USER postgres
ENTRYPOINT ["patroni", "/etc/patroni/patroni.yml"]
