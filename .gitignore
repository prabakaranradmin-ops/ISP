# Binaries
/bin/
/dist/
# `go build ./cmd/...` from the repo root drops the service executables here.
# Named individually rather than a bare *.exe so a deliberately committed
# tool would still have to be excluded on purpose, not by a blanket rule.
/api.exe
/radiusd.exe
/radload.exe
/bootstrap.exe

# Go build cache
*.test
*.test.exe
*.out
coverage.out
.coverage.out
.gotmp/
.testbin/

# Environment secrets — NEVER commit
.env

# IDE
.idea/
.vscode/settings.json
.vscode/mcp.json
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Excel lock files (created while a tracker is open)
~$*.xlsx

# Key material
config/keys/*.json
config/keys/*.pem

# Playwright E2E (browsers and run artefacts are large and machine-specific)
node_modules/
e2e/test-results/
e2e/playwright-report/
e2e/.cache/

# Playwright snapshots are regenerated on every run
e2e/snapshots/

# Ad-hoc live-verification screenshots (driven by hand against a running
# stack, not by the committed suite) — same reasoning as e2e/snapshots/
e2e/live-test/

# Demo walkthrough recordings (scripts/record_demo.sh). Multi-megabyte binaries
# regenerated from the live stack on demand — the specs that produce them are
# committed, the output is not.
e2e/demo-recordings/
e2e/demo-videos/
e2e/demo-frames/

# scripts/run_soak_test.sh output. .soak_users.csv is removed by the script's
# own cleanup trap on a normal exit; listed anyway in case a run is
# interrupted. soak_metrics_*.tsv is deliberately kept by the script itself
# (so a run can be re-analysed without repeating an hour of load) and would
# otherwise linger as clutter in every git status after every run.
.soak_users.csv
soak_metrics_*.tsv

# installer/build.ps1 output. stage/ holds the cross-compiled binaries and
# the copied-in PostgreSQL tree, obj/ is wix build's own intermediate
# folder, dist/ is the final .msi — regenerated from the committed
# Product.wxs and build.ps1 on demand, never committed itself (the
# PostgreSQL binaries alone put dist/*.msi well past what belongs in git).
installer/stage/
installer/obj/
installer/dist/
